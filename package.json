        "rgb",
        "hsl",
        "hwb",
        "lab",
        "lch",
        "oklab",
        "oklch"
    ],
    "homepage": "https://github.com/electrovir/color",
    "bugs": {
        "url": "https://github.com/electrovir/color/issues"
    },
    "repository": {
